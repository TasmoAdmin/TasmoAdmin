#!/usr/bin/with-contenv bash
# ==============================================================================
# Community Hass.io Add-ons: TasmoAdmin
# Ensures data is store in a persistent location
# ==============================================================================
# shellcheck disable=SC1091
#source /usr/lib/hassio-addons/base.sh

# The nginx config ships with the image and is refreshed on every boot so
# that security fixes reach existing installs. It is NOT read back from
# /data/nginx: the previous design copied the config into persistent storage
# once and required fragile in-place migrations forever after, which meant
# deployed nginx configs silently diverged from the reviewed one.
if [ -f /data/nginx/nginx.conf ]; then
  echo 'WARNING: /data/nginx/nginx.conf is no longer used - the image nginx config is now authoritative.'
  echo 'WARNING: if you customized it, those customizations NO LONGER APPLY. Your copy is preserved at'
  echo 'WARNING: /data/nginx/nginx.conf.unused - mount it at /etc/nginx/nginx.conf or bake it into a custom image.'
  rm -f /data/nginx/nginx.conf.unused
  mv /data/nginx/nginx.conf /data/nginx/nginx.conf.unused
  mv /data/nginx/nginx.conf.org /data/nginx/nginx.conf.org.unused 2>/dev/null || true
  mv /data/nginx/nginx-ssl.conf /data/nginx/nginx-ssl.conf.unused 2>/dev/null || true
fi

# SSL deployments keep their certificates in persistent storage; the shipped
# certs are empty placeholders.
if ${SSL}; then
    echo 'Using SSL nginx config...'
    # Keep a pristine copy of the non-SSL config so toggling SSL back off can
    # restore it; nginx.conf itself is overwritten below.
    cp -n /etc/nginx/nginx.conf /etc/nginx/nginx.conf.plain
    cp -f /etc/nginx/nginx-ssl.conf /etc/nginx/nginx.conf
    if [ ! -d "/data/nginx/certs" ]; then
      mkdir -p /data/nginx/certs
      cp -Rv /etc/nginx/certs/* /data/nginx/certs
    fi
    rm -rf /etc/nginx/certs
    echo 'Symlinking /etc/nginx/certs to persistent storage...'
    ln -s /data/nginx/certs /etc/nginx/certs
elif [ -f /etc/nginx/nginx.conf.plain ]; then
    echo 'SSL disabled, restoring non-SSL nginx config...'
    cp -f /etc/nginx/nginx.conf.plain /etc/nginx/nginx.conf
fi
