#!/usr/bin/with-contenv bash
# ==============================================================================
# Community Hass.io Add-ons: TasmoAdmin
# Ensures data is store in a persistent location
# ==============================================================================
# shellcheck disable=SC1091
#source /usr/lib/hassio-addons/base.sh

source /lib/init/s6-functions.sh

# Copy default nginx files to /data/nginx only when they do not exist yet
mkdir -p /data/nginx/certs

# A symlink here is a leftover from older versions
if [[ -L /data/nginx/nginx.conf ]]; then
  rm -f /data/nginx/nginx.conf
fi

cp -nv /usr/share/tasmoadmin/nginx-defaults/nginx.conf /data/nginx/nginx.conf
cp -nv /usr/share/tasmoadmin/nginx-defaults/nginx-ssl.conf /data/nginx/nginx-ssl.conf
cp -nv /usr/share/tasmoadmin/nginx-defaults/certs/* /data/nginx/certs/

echo 'Symlinking /etc/nginx.conf from persistent storage location...'
rm -rf /etc/nginx/nginx.conf
ln -s /data/nginx/nginx.conf /etc/nginx/nginx.conf

declare certfile
declare keyfile

if ${SSL}; then
  echo 'Symlinking /etc/nginx.conf to nginx-ssl.config on persistent storage...'
  rm -f -r /etc/nginx/nginx.conf
  ln -s /data/nginx/nginx-ssl.conf /etc/nginx/nginx.conf
  rm -f -r /etc/nginx/certs
  echo 'Symlinking /etc/nginx/certs to persistent storage...'
  ln -s /data/nginx/certs /etc/nginx/certs
fi

if is_unprivileged; then
  chown -R nginx:nginx /etc/nginx
  chown -R nginx:nginx /data/nginx

  mkdir -p /run/nginx /var/lib/nginx/tmp /var/log/nginx /var/log/php85
  chown -R nginx:nginx /run/nginx /var/lib/nginx /var/log/nginx /var/log/php85

  # Non-root nginx cannot write the default pid location
  sed -i -E 's@^pid .*;@pid /run/nginx/nginx.pid;@' /data/nginx/nginx.conf /data/nginx/nginx-ssl.conf
fi

echo "Setting nginx HTTP listen port to ${HTTP_PORT}..."
sed -i -E 's/^([[:space:]]*listen[[:space:]]+)[0-9]+/\1'"${HTTP_PORT}"'/' \
    /data/nginx/nginx.conf /data/nginx/nginx-ssl.conf
